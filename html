#include <stdio.h>
#include <string.h>
#include "NuMicro.h"
#include "Common.h"

typedef struct dma_desc_t
{
    uint32_t ctl;
    uint32_t src;
    uint32_t dest;
    uint32_t offset;
} DMA_DESC_T;

/*---------------------------------------------------------------------------------------------------------*/
/* Macro Definition                                                                                        */
/*---------------------------------------------------------------------------------------------------------*/
#define I2C0_PDMA_TX_CH    0                           /* PDMA channel used for I2C0 TX data transfer   */
#define I2C0_PDMA_RX_CH    1                           /* PDMA channel used for I2C0 RX data transfer   */

#define SG_TX_TAB_NUM      1                           /* Scatter-gather TX table number                */
#define SG_RX_TAB_NUM      5                           /* Scatter-gather RX table number                */
#define SG_TX_LENGTH       3                           /* Each scatter-gather TX transfer length (bytes)*/
#define SG_RX_LENGTH       2                           /* Each scatter-gather RX transfer length (bytes)*/
#define SG_BASE_ADDR       0x20000000

/* LED IO Definitions (Using PA4 as Red LED, PA5 as Green LED) */
#define LED_RED_PIN        BIT4
#define LED_GREEN_PIN      BIT5

/*---------------------------------------------------------------------------------------------------------*/
/* Global Variables                                                                                        */
/*---------------------------------------------------------------------------------------------------------*/
uint8_t SrcArray[SG_TX_LENGTH * SG_TX_TAB_NUM];       /* TX source data buffer                         */
uint8_t DestArray[SG_RX_LENGTH * SG_RX_TAB_NUM];      /* RX destination data buffer                    */

DMA_DESC_T DMA_DESC_SC_TX[SG_TX_TAB_NUM];             /* PDMA TX scatter-gather descriptor table       */
DMA_DESC_T DMA_DESC_SC_RX[SG_RX_TAB_NUM];             /* PDMA RX scatter-gather descriptor table       */

typedef void (*I2C_FUNC)(uint32_t u32Status);

volatile static I2C_FUNC s_I2C0HandlerFn = NULL;
uint32_t NCT7712Y_Data = 0;
float NCT7712Y_Data_F = 0;
volatile uint32_t PDMA_DONE = 0;
uint8_t g_u8DeviceAddr = 0x48;

/*---------------------------------------------------------------------------------------------------------*/
/* Function: Build_Tx_SCTab                                                                                */
/* Purpose : Build scatter-gather descriptor table for I2C0 TX PDMA channel                                */
/*---------------------------------------------------------------------------------------------------------*/
void Build_Tx_SCTab(uint32_t u32TabNum, uint32_t u32TxSize, uint32_t u32StartAddr)
{
    uint32_t i;

    for (i = 0; i < u32TabNum; i++)
    {
        DMA_DESC_SC_TX[i].ctl = PDMA_OP_SCATTER |
                                PDMA_REQ_SINGLE |
                                PDMA_DAR_FIX |                /* Destination address -> fixed (I2C0 DAT) */
                                PDMA_SAR_INC |                /* Source address -> incremented */
                                PDMA_WIDTH_8 |                /* Transfer width -> 8-bit */
                                PDMA_TBINTDIS_DISABLE |       /* Table interrupt disable */
                                ((u32TxSize - 1) << PDMA_DSCT_CTL_TXCNT_Pos);
        DMA_DESC_SC_TX[i].src    = (uint32_t)(u32StartAddr + i * u32TxSize);
        DMA_DESC_SC_TX[i].dest   = (uint32_t)&(I2C0->DAT);
        DMA_DESC_SC_TX[i].offset = (uint32_t)&DMA_DESC_SC_TX[0] - SG_BASE_ADDR; /* Circular: always loops back to [0] */
    }
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: Build_Rx_SCTab                                                                                */
/* Purpose : Build scatter-gather descriptor table for I2C0 RX PDMA channel; last entry uses basic mode  */
/*---------------------------------------------------------------------------------------------------------*/
void Build_Rx_SCTab(uint32_t u32TabNum, uint32_t u32RxSize, uint32_t u32StartAddr)
{
    uint32_t i;

    for (i = 0; i < u32TabNum; i++)
    {
        DMA_DESC_SC_RX[i].ctl = PDMA_OP_SCATTER |
                                PDMA_REQ_SINGLE |
                                PDMA_SAR_FIX |                /* Source address -> fixed (I2C0 DAT) */
                                PDMA_DAR_INC |                /* Destination address -> incremented */
                                PDMA_WIDTH_8 |                /* Transfer width -> 8-bit */
                                PDMA_TBINTDIS_DISABLE |       /* Table interrupt disable */
                                ((u32RxSize - 1) << PDMA_DSCT_CTL_TXCNT_Pos);
        DMA_DESC_SC_RX[i].src    = (uint32_t)&(I2C0->DAT);
        DMA_DESC_SC_RX[i].dest   = (uint32_t)(u32StartAddr + i * u32RxSize);
        DMA_DESC_SC_RX[i].offset = (uint32_t)&DMA_DESC_SC_RX[0] + 0x10 * (i + 1) - (PDMA0->SCATBA);
    }

    /* For the last entry: enable transfer-done interrupt and switch to basic mode */
    DMA_DESC_SC_RX[u32TabNum - 1].ctl = (DMA_DESC_SC_RX[u32TabNum - 1].ctl & ~(PDMA_DSCT_CTL_TBINTDIS_Msk | PDMA_DSCT_CTL_OPMODE_Msk)) |
                                        (PDMA_TBINTDIS_ENABLE | PDMA_OP_BASIC);
    DMA_DESC_SC_RX[u32TabNum - 1].offset = 0;
}

/*---------------------------------------------------------------------------------------------------------*/
/* TIMER Initialization Function                                                                           */
/*---------------------------------------------------------------------------------------------------------*/
void TIMER_Init(void)
{
    /* Set TIMER0 clock source from LIRC */
    SYS_UnlockReg();
    CLK_SetModuleClock(TMR0_MODULE, CLK_CLKSEL1_TMR0SEL_LIRC, 0);
    CLK_EnableModuleClock(TMR0_MODULE);
    SYS_LockReg();

    /* Open TIMER0 to periodic mode, 1 Hz */
    TIMER_Open(TIMER0, TIMER_PERIODIC_MODE, 2);

    /* Enable TIMER0 Power-down engine clock */
    TIMER0->CTL |= TIMER_CTL_PDCLKEN_Msk;

    /* Set TIMER0 to trigger I2C when TIMER0 timeout */
    TIMER_SetATriggerSource(TIMER0, TIMER_ATRGSRC_TIMEOUT_EVENT);

    /* Enable TIMER0 to trigger Other Peripheral */
    TIMER_SetATriggerTarget(TIMER0, TIMER_ATRG_TO_IPS);

    /* Disable CPU wake-up by timer */
    TIMER_DisableWakeup(TIMER0);
}

/*---------------------------------------------------------------------------------------------------------*/
/* PDMA Interrupt Handler                                                                                  */
/* Triggered when I2C0 TX or RX PDMA transfer is done; prints transfer-done message and wakes up CPU     */
/*---------------------------------------------------------------------------------------------------------*/
void PDMA0_IRQHandler(void)
{
    uint32_t u32Status = PDMA0->TDSTS;

    /* Master RX */
    if (u32Status & (0x1 << I2C0_PDMA_RX_CH))
    {
        PDMA0->TDSTS = 0x1 << I2C0_PDMA_RX_CH;
        PDMA_DONE = 1;
    }
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: PDMA_TX_Init                                                                                  */
/* Purpose : Configure PDMA channel for I2C0 TX in scatter-gather mode                                   */
/*---------------------------------------------------------------------------------------------------------*/
void PDMA_TX_Init(uint8_t u8TestCh, uint32_t u32TabNum, uint32_t u32TestLen)
{
    PDMA_Open(PDMA0, 1 << u8TestCh);

    /* Setup Scatter-gather table for TX transfer */
    Build_Tx_SCTab(u32TabNum, u32TestLen, (uint32_t)&SrcArray);

    PDMA_SetTransferMode(PDMA0, u8TestCh, PDMA_I2C0_TX, 1, (uint32_t)&DMA_DESC_SC_TX[0]);
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: PDMA_RX_Init                                                                                  */
/* Purpose : Configure PDMA channel for I2C0 RX in scatter-gather mode; enable transfer-done interrupt   */
/*---------------------------------------------------------------------------------------------------------*/
void PDMA_RX_Init(uint8_t u8TestCh, uint32_t u32TabNum, uint32_t u32TestLen)
{
    PDMA_Open(PDMA0, 1 << u8TestCh);

    /* Setup Scatter-gather table for RX transfer */
    Build_Rx_SCTab(u32TabNum, u32TestLen, (uint32_t)&DestArray);

    PDMA_SetTransferMode(PDMA0, u8TestCh, PDMA_I2C0_RX, 1, (uint32_t)&DMA_DESC_SC_RX[0]);

    /* Enable channel transfer done interrupt */
    PDMA_EnableInt(PDMA0, I2C0_PDMA_RX_CH, PDMA_INT_TRANS_DONE);
    NVIC_EnableIRQ(PDMA0_IRQn);
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: I2C_Trigger_Init                                                                             */
/* Purpose : Configure I2C0 auto-operation mode, trigger source, and RX/TX byte count                     */
/*---------------------------------------------------------------------------------------------------------*/
void I2C_Trigger_Init(uint32_t u32Mode, uint32_t u32Src, uint32_t u32RxCnt, uint32_t u32TxCnt)
{
    /* Set Auto-operation Mode */
    I2C0->AUTOCTL = (I2C0->AUTOCTL & ~I2C_AUTOCTL_AUTOMODE_Msk) | (u32Mode);

    /* Trigger source select */
    I2C0->AUTOCTL = (I2C0->AUTOCTL & ~I2C_AUTOCTL_TGSRCSEL_Msk) | (u32Src);

    I2C0->AUTOCNT = (I2C0->AUTOCNT & ~(I2C_AUTOCNT_RXCNT_Msk | I2C_AUTOCNT_TXCNT_Msk));

    if (u32RxCnt != 0)
        I2C0->AUTOCNT |= ((u32RxCnt - 1) << I2C_AUTOCNT_RXCNT_Pos);

    if (u32TxCnt != 0)
        I2C0->AUTOCNT |= ((u32TxCnt - 1) << I2C_AUTOCNT_TXCNT_Pos);

    I2C0->AUTOCTL |= I2C_AUTOCTL_TRGEN_Msk;
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: I2C0_IRQHandler                                                                               */
/* Purpose : I2C0 interrupt handler; dispatches to registered callback or clears timeout flag             */
/*---------------------------------------------------------------------------------------------------------*/
void I2C0_IRQHandler(void)
{
    uint32_t u32Status;

    u32Status = I2C_GET_STATUS(I2C0);

    if (I2C_GET_TIMEOUT_FLAG(I2C0))
    {
        /* Clear I2C0 timeout flag */
        I2C_ClearTimeoutFlag(I2C0);
    }
    else
    {
        if (s_I2C0HandlerFn != NULL)
            s_I2C0HandlerFn(u32Status);
    }
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: I2C_PDMA_MasterRx                                                                             */
/* Purpose : I2C0 PDMA Master Rx callback; handles bus states during auto-operation random read           */
/*---------------------------------------------------------------------------------------------------------*/
void I2C_PDMA_MasterRx(uint32_t u32Status)
{
    if (u32Status == 0x08)                             /* START has been transmitted */
    {
    }
    else if (u32Status == 0x18)                        /* SLA+W has been transmitted and ACK has been received */
    {
    }
    else if (u32Status == 0x20)                        /* SLA+W has been transmitted and NACK has been received */
    {
        I2C_STOP(I2C0);
        I2C_START(I2C0);
    }
    else if (u32Status == 0x28)                        /* DATA has been transmitted and ACK has been received */
    {
    }
    else if (u32Status == 0x10)                        /* Repeat START has been transmitted */
    {
    }
    else if (u32Status == 0x40)                        /* SLA+R has been transmitted and ACK has been received */
    {
    }
    else if (u32Status == 0x50)                        /* DATA has been received and ACK has been returned */
    {
    }
    else if (u32Status == 0x58)                        /* DATA has been received and NACK has been returned */
    {
    }
    else
    {
        printf("Status 0x%x is NOT processed\\n", u32Status);
    }
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: GPIO_LED_Init                                                                                 */
/* Purpose : Configure PA4 and PA5 as GPIO output for LED indicator control                                 */
/*---------------------------------------------------------------------------------------------------------*/
void GPIO_LED_Init(void)
{
    /* Enable Port A GPIO module clock */
    CLK_EnableModuleClock(GPA_MODULE);

    /* Configure PA4/PA5 multi-function pins as GPIO */
    SYS->GPA_MFPL = (SYS->GPA_MFPL & ~(SYS_GPA_MFPL_PA4MFP_Msk)) | (SYS_GPA_MFPL_PA4MFP_GPIO);
    SYS->GPA_MFPL = (SYS->GPA_MFPL & ~(SYS_GPA_MFPL_PA5MFP_Msk)) | (SYS_GPA_MFPL_PA5MFP_GPIO);

    /* Set PA4/PA5 as output mode */
    GPIO_SetMode(PA, LED_RED_PIN | LED_GREEN_PIN, GPIO_MODE_OUTPUT);
    
    /* Keep LEDs off initially (Assuming Active-Low based on Min_Current_Init driving High) */
    PA->DOUT |= (LED_RED_PIN | LED_GREEN_PIN);
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: SYS_Init                                                                                      */
/* Purpose : Configure system clock - HIRC as HCLK with divider=1, enable LIRC, peripheral clocks, MFPs  */
/*---------------------------------------------------------------------------------------------------------*/
void SYS_Init(void)
{
    /* Unlock protected registers */
    SYS_UnlockReg();

    /* Enable HIRC clock */
    CLK_EnableXtalRC(CLK_PWRCTL_HIRCEN_Msk);
    CLK_WaitClockReady(CLK_STATUS_HIRCSTB_Msk);

    /* Enable LIRC clock */
    CLK_EnableXtalRC(CLK_PWRCTL_LIRCEN_Msk);
    CLK_WaitClockReady(CLK_STATUS_LIRCSTB_Msk);

    /* Select HCLK clock source as HIRC and HCLK clock divider as 1 */
    CLK_SetHCLK(CLK_CLKSEL0_HCLKSEL_HIRC, 0);

    /* Set APB0 and APB1 clock divider as 2 */
    CLK->PCLKDIV = (CLK_PCLKDIV_APB0DIV_DIV2 | CLK_PCLKDIV_APB1DIV_DIV2);

    /* Update System Core Clock */
    SystemCoreClockUpdate();

    /* Enable PDMA0 clock */
    CLK_EnableModuleClock(PDMA0_MODULE);

    /* Enable GPIO clock */
    CLK_EnableModuleClock(GPA_MODULE);

    /* Lock protected registers */
    SYS_LockReg();
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: UART0_Init                                                                                    */
/* Purpose : Configure UART0 clock, MFP, and open at 115200 baud                                           */
/*---------------------------------------------------------------------------------------------------------*/
void UART0_Init(void)
{
    /* Select UART0 clock source as HIRC and UART module clock divider as 1 */
    CLK_SetModuleClock(UART0_MODULE, CLK_CLKSEL2_UART0SEL_HIRC, CLK_CLKDIV_UART0(1));

    /* Enable UART0 peripheral clock */
    CLK_EnableModuleClock(UART0_MODULE);

    /* Set PB.13 multi-function pin for UART0 TXD (TX only to avoid RX pin current leakage) */
    SYS->GPB_MFPH = (SYS->GPB_MFPH & ~SYS_GPB_MFPH_PB13MFP_Msk) | SYS_GPB_MFPH_PB13MFP_UART0_TXD;

    /* Reset UART0 */
    SYS_ResetModule(UART0_RST);

    /* Configure UART0 and set UART0 Baudrate */
    UART_Open(UART0, 115200);
}

/*---------------------------------------------------------------------------------------------------------*/
/* Function: I2C_Init                                                                                      */
/* Purpose : Open I2C0 at 100kHz and enable I2C0 interrupt                                                 */
/*---------------------------------------------------------------------------------------------------------*/
void I2C_Init(void)
{
    /* Enable I2C0 clock */
    CLK_EnableModuleClock(I2C0_MODULE);

    /* Set I2C0 multi-function pins: PC0=SDA, PC1=SCL */
    SYS->GPC_MFPL = (SYS->GPC_MFPL & ~(SYS_GPC_MFPL_PC0MFP_Msk | SYS_GPC_MFPL_PC1MFP_Msk)) |
                    (SYS_GPC_MFPL_PC0MFP_I2C0_SDA | SYS_GPC_MFPL_PC1MFP_I2C0_SCL);

    /* I2C pin enable schmitt trigger */
    PC->SMTEN |= GPIO_SMTEN_SMTEN0_Msk | GPIO_SMTEN_SMTEN1_Msk;

    /* Open I2C0 module and set bus clock to 100kHz */
    I2C_Open(I2C0, 100000);

    /* Enable I2C0 interrupt */
