/*---------------------------------------------------------------------------------------------------------*/
/* Function: AutoOperation_FunctionTest                                                                    */
/* Purpose : Init PDMA, start Timer0, enter power-down for I2C auto-read via PDMA; decode and print       */
/* NCT7712Y temperature sensor data on wakeup, and control LEDs based on temperature threshold  */
/*---------------------------------------------------------------------------------------------------------*/
void AutoOperation_FunctionTest(void)
{
    uint32_t i;
    uint8_t *pu8Tmp;

    PDMA_DONE = 0;

    /* Build I2C write frame: SLV+W, register address, SLV+R */
    pu8Tmp = SrcArray;
    for (i = 0; i < SG_TX_TAB_NUM; i++)
    {
        *pu8Tmp++ = ((g_u8DeviceAddr << 1) | 0x00);   /* SLV + W              */
        *pu8Tmp++ = 0x00;                              /* Register address     */
        *pu8Tmp++ = ((g_u8DeviceAddr << 1) | 0x01);   /* SLV + R              */
    }

    /* Set I2C0 interrupt callback for master receive operation */
    s_I2C0HandlerFn = (I2C_FUNC)I2C_PDMA_MasterRx;

    I2C_SET_CONTROL_REG(I2C0, I2C_CTL_AA);

    /* PDMA CH0 scatter-gather mode to write data to slave */
    PDMA_TX_Init(I2C0_PDMA_TX_CH, SG_TX_TAB_NUM, SG_TX_LENGTH);

    /* PDMA CH1 scatter-gather mode to receive data from slave */
    PDMA_RX_Init(I2C0_PDMA_RX_CH, SG_RX_TAB_NUM, SG_RX_LENGTH);

    /* Auto operation random read mode with repeat start */
    I2C_Trigger_Init(I2C_RANDOM_REPEAT_STA, I2C_AUTOCTL_TRIGSEL_TMR0, SG_RX_LENGTH, SG_TX_LENGTH);

    /* Set Power-down mode */
    SYS_UnlockReg();
    CLK_SetPowerDownMode(CLK_PMUCTL_PDMSEL_NPD1);

    /* Clear all wakeup flags */
    CLK->PMUSTS |= CLK_PMUSTS_CLRWK_Msk;

    printf("Power down\\n");
    UART_WAIT_TX_EMPTY(UART0);

    CLK->PMUCTL = (CLK->PMUCTL & ~(CLK_PMUCTL_PDLDCSEL_Msk)) | CLK_PMUCTL_PDLDCSEL_ULP;
    CLK_PowerDown();
    SYS_LockReg();

    printf("\\nWakeup\\n");
    UART_WAIT_TX_EMPTY(UART0);

    uint32_t u32Timeout = SystemCoreClock;
    while (!PDMA_DONE)
    {
        if (u32Timeout-- == 0)
        {
            printf("PDMA timeout error!\\n");
            return;
        }
    }

    printf("I2C0 Rx done\\n");

    /* Decode raw temperature data from NCT7712Y (12-bit, 0.0625 C/LSB) and print result */
    for (i = 0; i < SG_RX_TAB_NUM * 2; i += 2)
    {
        NCT7712Y_Data  = DestArray[i];
        NCT7712Y_Data <<= 8;
        NCT7712Y_Data |= DestArray[i + 1];

        NCT7712Y_Data >>= 4;                           /* bit0 ~ bit3 are reserved */

        /* Determine if the temperature is positive or negative */
        if (NCT7712Y_Data & 0x800)
        {
            /* Get NCT7712Y_Data 2's complement */
            NCT7712Y_Data = ~NCT7712Y_Data & 0x00000FFF;
            NCT7712Y_Data += 1;

            /* Get negative Celsius temperature value */
            NCT7712Y_Data_F = (float)(NCT7712Y_Data * -0.0625f);
        }
        else
        {
            /* Get positive Celsius temperature value */
            NCT7712Y_Data_F = (float)(NCT7712Y_Data * 0.0625f);
        }

        printf("Current Temperature = %.4f degrees Celsius.\\n", NCT7712Y_Data_F);

        /* LED control logic based on 27 degrees threshold (Assuming Active-Low LED configuration) */
        if (NCT7712Y_Data_F > 27.0f)
        {
            PA->DOUT &= ~LED_RED_PIN;    /* Light up Red LED (Low) */
            PA->DOUT |= LED_GREEN_PIN;   /* Turn off Green LED (High) */
        }
        else
        {
            PA->DOUT |= LED_RED_PIN;     /* Turn off Red LED (High) */
            PA->DOUT &= ~LED_GREEN_PIN;  /* Light up Green LED (Low) */
        }
    }

    printf("\\n");
}

