        let isFullCodeMode = false;

        // DOM ELEMENTS
        const stepBadge = document.getElementById("stepBadge");
        const stepCategory = document.getElementById("stepCategory");
        const stepTitle = document.getElementById("stepTitle");
        const stepContent = document.getElementById("stepContent");
        
        // Code viewer nodes
        const codeDisplay = document.getElementById("codeDisplay");
        const lineNumbers = document.getElementById("lineNumbers");
        const codeFileName = document.getElementById("codeFileName");
        const copyCodeBtn = document.getElementById("copyCodeBtn");
        
        // Tab modes
        const modeStepBtn = document.getElementById("modeStepBtn");
        const modeFullBtn = document.getElementById("modeFullBtn");
        
        // Navigation nodes
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const progressBar = document.getElementById("progressBar");
        const progressText = document.getElementById("progressText");
        const stepIndicatorContainer = document.getElementById("stepIndicatorContainer");
        
        // Toast
        const toast = document.getElementById("toast");
        const toastMsg = document.getElementById("toastMsg");

        // INITIALIZE QUICK JUMP NAVIGATION BUTTONS
        function initStepIndicators() {
            stepIndicatorContainer.innerHTML = "";
            steps.forEach((step, idx) => {
                const btn = document.createElement("button");
                btn.className = `py-1.5 rounded-lg text-xs font-mono font-bold border transition ${
                    idx === currentStepIndex 
                    ? "bg-rose-500 text-white border-rose-400" 
                    : "bg-[#0f172a] hover:bg-slate-800 text-slate-400 border-slate-800"
                }`;
                btn.innerText = `S${idx + 1}`;
                btn.addEventListener("click", () => {
                    currentStepIndex = idx;
                    renderStep();
                });
                stepIndicatorContainer.appendChild(btn);
            });
        }

        // PREMIUM SYNTAX HIGHLIGHTING GENERATOR FOR C CODE
        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }

        function highlightCCode(code) {
            let escaped = escapeHtml(code);
            
            // Types and Structs
            escaped = escaped.replace(/\b(uint32_t|uint8_t|float|void|int|typedef|struct|volatile|static)\b/g, '<span class="text-rose-400 font-semibold">$1</span>');
            
            // Keywords
            escaped = escaped.replace(/\b(for|if|else|while|return|define|include)\b/g, '<span class="text-amber-400 font-semibold">$1</span>');
            
            // Numbers and Hex
            escaped = escaped.replace(/\b(0x[0-9a-fA-F]+|\b\d+\b)\b/g, '<span class="text-cyan-400 font-mono">$1</span>');
            
            // Functions
            escaped = escaped.replace(/\b([A-Za-z0-9_]+)(?=\()/g, '<span class="text-blue-400 font-semibold">$1</span>');
            
            // Comments (Multi-line and Single-line)
            escaped = escaped.replace(/(\/\*[\s\S]*?\*\/)/g, '<span class="text-slate-500 italic">$1</span>');
            escaped = escaped.replace(/(\/\/.*)/g, '<span class="text-slate-500 italic">$1</span>');
            
            // Macros (#define, #include etc)
            escaped = escaped.replace(/(#[A-Za-z]+)/g, '<span class="text-amber-500 font-semibold">$1</span>');

            return escaped;
        }

        // SYNC LINE NUMBERS GENERATION
        function updateLineNumbers(codeText) {
            const lines = codeText.split('\n').length;
            let numberString = '';
            for (let i = 1; i <= Math.max(lines, 1); i++) {
                numberString += i + '<br>';
            }
            lineNumbers.innerHTML = numberString;
        }

        // MAIN STEP RENDER FUNCTION
        function renderStep() {
            const step = steps[currentStepIndex];
            
            // 1. Text descriptions update
            stepBadge.innerText = step.badge;
            stepCategory.innerText = step.category;
            stepTitle.innerText = step.title;
            stepContent.innerHTML = step.content;

            // 2. Progress percentage
            const percentage = ((currentStepIndex + 1) / steps.length) * 100;
            progressBar.style.width = `${percentage}%`;
            progressText.innerText = `${currentStepIndex + 1} / ${steps.length}`;

            // 3. Navigation state
            prevBtn.disabled = currentStepIndex === 0;
            
            if (currentStepIndex === steps.length - 1) {
                nextBtn.innerHTML = `重頭開始 <i class="fa-solid fa-rotate-left"></i>`;
            } else {
                nextBtn.innerHTML = `下一步 <i class="fa-solid fa-chevron-right"></i>`;
            }

            // 4. Update Quick Jumps Indicator
            initStepIndicators();

            // 5. Code panel render
            renderCodeBlock();
        }

        // RENDER CODE BLOCK BASED ON VIEW MODE
        function renderCodeBlock() {
            let activeCode = "";
            if (isFullCodeMode) {
                activeCode = fullSourceCode;
                codeFileName.innerHTML = `完整主程式: <span class="text-amber-400 font-mono">main.c</span>`;
                copyCodeBtn.innerHTML = `<i class="fa-solid fa-clone"></i> <span>複製全專案程式碼</span>`;
            } else {
                activeCode = steps[currentStepIndex].code;
                codeFileName.innerHTML = `步驟 ${currentStepIndex + 1} 片段: <span class="text-rose-400 font-mono">main.c</span>`;
                copyCodeBtn.innerHTML = `<i class="fa-solid fa-clone"></i> <span>複製此步驟程式碼</span>`;
            }

            // Apply highlighters and line numbers
            codeDisplay.innerHTML = highlightCCode(activeCode);
            updateLineNumbers(activeCode);
        }

        // CLIPBOARD COPY UTILITY WITH IFRAME FALLBACK
        function copyToClipboard(text) {
            // High-compatibility textarea copy method
            const textArea = document.createElement("textarea");
            textArea.value = text;
            // Avoid scrolling to bottom
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.position = "fixed";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();

            try {
                const successful = document.execCommand('copy');
                if (successful) {
                    showToast(isFullCodeMode ? "已成功複製完整的 main.c 專案！" : `已成功複製 步驟 ${currentStepIndex + 1} 程式片段！`);
                } else {
                    showToast("複製失敗，請手動複製！", true);
                }
            } catch (err) {
                showToast("瀏覽器不支援自動複製，請手動複製！", true);
            }

            document.body.removeChild(textArea);
        }

        // SHOW CUSTOM TOAST MESSAGE
        function showToast(message, isError = false) {
            toastMsg.innerText = message;
            if (isError) {
                toast.classList.remove("border-emerald-500", "text-emerald-400");
                toast.classList.add("border-rose-500", "text-rose-400");
            } else {
                toast.classList.remove("border-rose-500", "text-rose-400");
                toast.classList.add("border-emerald-500", "text-emerald-400");
            }

            // Animation classes
            toast.classList.remove("opacity-0", "translate-y-10", "pointer-events-none");
            toast.classList.add("opacity-100", "translate-y-0");

            setTimeout(() => {
                toast.classList.remove("opacity-100", "translate-y-0");
                toast.classList.add("opacity-0", "translate-y-10", "pointer-events-none");
            }, 3000);
        }

        // EVENT LISTENERS REGISTER
        copyCodeBtn.addEventListener("click", () => {
            const activeCode = isFullCodeMode ? fullSourceCode : steps[currentStepIndex].code;
            copyToClipboard(activeCode);
        });

        // Toggle code view modes
        modeStepBtn.addEventListener("click", () => {
            isFullCodeMode = false;
            modeStepBtn.className = "px-2.5 py-1 rounded bg-slate-800 text-amber-400 font-semibold transition text-[10px]";
            modeFullBtn.className = "px-2.5 py-1 rounded text-slate-400 hover:text-slate-200 transition text-[10px]";
            renderCodeBlock();
        });

        modeFullBtn.addEventListener("click", () => {
            isFullCodeMode = true;
            modeFullBtn.className = "px-2.5 py-1 rounded bg-slate-800 text-amber-400 font-semibold transition text-[10px]";
            modeStepBtn.className = "px-2.5 py-1 rounded text-slate-400 hover:text-slate-200 transition text-[10px]";
            renderCodeBlock();
        });

        // Steps navigation handlers
        nextBtn.addEventListener("click", () => {
            if (currentStepIndex === steps.length - 1) {
                currentStepIndex = 0;
            } else {
                currentStepIndex++;
            }
            renderStep();
        });

        prevBtn.addEventListener("click", () => {
            if (currentStepIndex > 0) {
                currentStepIndex--;
                renderStep();
            }
        });

        // WINDOW INITIALIZATION
        window.onload = function() {
            renderStep();
        };
    </script>
</body>
</html>